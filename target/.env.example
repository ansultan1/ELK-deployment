# Copy to target/.env on the TARGET VM and fill in (values come from the ELK VSI's .env)
STACK_VERSION=8.15.3
ELK_HOST=<ELK VSI floating IP>          # must be the IP the TLS certs were issued for (VSI_IP)
ENVIRONMENT=otel-demo
BEATS_PASSWORD=                          # beats_internal (metrics -> Elasticsearch)
APM_SECRET_TOKEN=                        # OTLP traces/logs/metrics -> APM Server
RCA_PASSWORD=                            # rca_internal (scenario runner writes ground truth)
# Certs copied from the ELK VSI's certs/ dir into target/certs/: ca/ca.crt, beat-client/beat-client.{crt,key}
DEMO_DIR=/opt/opentelemetry-demo
DEMO_VERSION=3.1.0
